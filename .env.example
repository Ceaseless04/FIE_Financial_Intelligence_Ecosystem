# Copy to .env for local development:  cp .env.example .env
#
# .env is gitignored. Never commit real credentials.
#
# The values below are development defaults and are REJECTED in production by
# fie_common.config.require_production_secret — it fails startup on known
# placeholders, on strings containing development markers ("insecure",
# "local-development", "change-me", ...), and on anything under 32 characters.

# --- core ------------------------------------------------------------------
FIE_ENVIRONMENT=development
FIE_SERVICE_NAME=fie-dev
FIE_LOG_LEVEL=DEBUG
FIE_DEBUG=true
FIE_JSON_LOGS=false

# --- AI providers ----------------------------------------------------------
# claude | ollama | vllm
FIE_AI_DEFAULT_PROVIDER=ollama
FIE_AI_ENABLED_PROVIDERS=["ollama"]
FIE_AI_FALLBACK_PROVIDERS=[]

# Set a real key and switch the default provider to `claude` to use it.
# FIE_CLAUDE_API_KEY=sk-ant-...
FIE_CLAUDE_MODEL=claude-opus-5
FIE_CLAUDE_MAX_TOKENS=4096
FIE_CLAUDE_TIMEOUT_SECONDS=120

FIE_OLLAMA_BASE_URL=http://localhost:11434
FIE_OLLAMA_MODEL=llama3.1:8b

FIE_VLLM_BASE_URL=http://localhost:8000/v1
FIE_VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- auth ------------------------------------------------------------------
FIE_AUTH_JWT_SECRET=insecure-development-secret-do-not-use
FIE_AUTH_JWT_ALGORITHM=HS256
FIE_AUTH_ISSUER=fie-platform
FIE_AUTH_AUDIENCE=fie-services
FIE_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
FIE_AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600

# --- PostgreSQL ------------------------------------------------------------
FIE_POSTGRES_HOST=localhost
FIE_POSTGRES_PORT=5432
FIE_POSTGRES_USER=fie
FIE_POSTGRES_PASSWORD=fie-local-development
FIE_POSTGRES_DATABASE=fie
FIE_POSTGRES_POOL_SIZE=10
FIE_POSTGRES_ECHO=false

# --- Redis -----------------------------------------------------------------
FIE_REDIS_HOST=localhost
FIE_REDIS_PORT=6379
FIE_REDIS_DB=0
# FIE_REDIS_PASSWORD=

# --- Neo4j -----------------------------------------------------------------
FIE_NEO4J_URI=bolt://localhost:7687
FIE_NEO4J_USER=neo4j
FIE_NEO4J_PASSWORD=fie-local-development
FIE_NEO4J_DATABASE=neo4j

# --- events ----------------------------------------------------------------
FIE_EVENTS_BATCH_SIZE=32
FIE_EVENTS_MAX_DELIVERY_ATTEMPTS=5
FIE_EVENTS_RECLAIM_IDLE_MS=60000

# --- MarketMind (knowledge graph) ------------------------------------------
# Loopback by default. Binding every interface is a deployment decision, so the
# container image opts in explicitly rather than the application defaulting to it.
MARKETMIND_API_HOST=127.0.0.1
MARKETMIND_API_PORT=8001

# Embeddings come from a local model server; Anthropic has no embeddings API.
MARKETMIND_EMBEDDING_BASE_URL=http://localhost:11434
MARKETMIND_EMBEDDING_MODEL=nomic-embed-text
# Must equal the pgvector column width. Changing the model needs a migration,
# so startup fails rather than letting every insert fail with a dimension error.
MARKETMIND_EMBEDDING_DIMENSIONS=768
MARKETMIND_EMBEDDING_BATCH_SIZE=32

# Chunking is measured in characters so it stays tokenizer-independent and
# therefore reproducible across embedding backends.
MARKETMIND_CHUNK_MAX_CHARS=1200
MARKETMIND_CHUNK_OVERLAP_CHARS=150
MARKETMIND_CHUNK_MIN_CHARS=100

# Entity resolution thresholds. Conservative on purpose: a missed merge leaves
# two nodes a later pass can combine, a wrong merge fuses two real companies.
MARKETMIND_RESOLUTION_FUZZY_THRESHOLD=92
MARKETMIND_RESOLUTION_MINIMUM_CANDIDATE_SCORE=80
MARKETMIND_RESOLUTION_MINIMUM_TOKEN_OVERLAP=0.5

# Retrieval breadth. Precision beats recall when every claim must be cited.
MARKETMIND_RETRIEVAL_TOP_K_CHUNKS=6
MARKETMIND_RETRIEVAL_GRAPH_DEPTH=1
MARKETMIND_RETRIEVAL_MAX_NEIGHBOURS=20
MARKETMIND_RETRIEVAL_MINIMUM_SIMILARITY=0.15

# APOC ships with the dev Neo4j image but not every managed offering.
MARKETMIND_GRAPH_USE_APOC=false
MARKETMIND_GRAPH_VISUALIZATION_MAX_NODES=250

# --- Atlas (financial research) ---------------------------------------------
# Loopback by default, for the same reason as MarketMind above.
ATLAS_API_HOST=127.0.0.1
ATLAS_API_PORT=8002

# Statements sit in the financial section of a filing; sending a whole 10-K
# buries the tables among the risk factors and pays for the context twice.
ATLAS_EXTRACTION_MAX_CONTENT_CHARS=60000
ATLAS_EXTRACTION_MAX_TOKENS=4096

# One corrective retry when a draft quotes a figure Atlas did not compute. More
# than one is rerolling the same dice and paying for it; the report is returned
# either way, marked unpublishable.
ATLAS_REPORT_MAX_TOKENS=4096
ATLAS_REPORT_MAX_REGENERATIONS=1

# Starting points for a DCF, not recommendations. Every valuation records the
# assumptions it actually used. Startup fails if the discount rate does not
# clear terminal growth: a terminal value from a narrower spread diverges.
ATLAS_DEFAULT_DISCOUNT_RATE=0.10
ATLAS_DEFAULT_TERMINAL_GROWTH=0.025
ATLAS_DEFAULT_FORECAST_YEARS=5

# Company context from the knowledge graph. Atlas degrades to no context rather
# than failing when MarketMind is unreachable — so a missing token in production
# would show up as reports that quietly carry no context, and startup rejects it.
ATLAS_MARKETMIND_BASE_URL=http://localhost:8001
ATLAS_MARKETMIND_TIMEOUT_SECONDS=10
ATLAS_MARKETMIND_ENABLED=true
# ATLAS_MARKETMIND_TOKEN=   # required when FIE_ENVIRONMENT=production

# --- testing ---------------------------------------------------------------
# Which services must be running for integration tests to fail rather than skip.
# Use `1` for all of them, or name the ones your environment actually provides.
# FIE_REQUIRE_INFRA=postgres,redis,neo4j
