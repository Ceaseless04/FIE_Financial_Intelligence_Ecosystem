# Normalize line endings in the repository.
* text=auto eol=lf

# These are executed inside Linux containers. CRLF would break the shebang
# ("bad interpreter: /bin/sh^M") and corrupt SQL bootstrap scripts.
*.sh text eol=lf
*.sql text eol=lf
Dockerfile* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.pdf binary
*.ico binary
